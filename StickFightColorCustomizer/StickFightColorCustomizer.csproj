  <Target Name="DeployToMods" AfterTargets="Build">

    <MakeDir Directories="$(ModsDir)" Condition="!Exists('$(ModsDir)')" />

    <Delete Files="$(ModsDir)\StickFightColorCustomizer.dll" Condition="Exists('$(ModsDir)\StickFightColorCustomizer.dll')" />

    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsDir)" SkipUnchangedFiles="false" />

    <Message Importance="high" Text="[Deploy] $(TargetFileName) -&gt; $(ModsDir)" />

    <!-- Deploy PNG hat images to <ModsDir>/AlkaSkin_Images -->

    <PropertyGroup>

      <ImagesSourceDir>$(MSBuildProjectDirectory)\AlkaSkin_Images</ImagesSourceDir>

      <ImagesDestDir>$(ModsDir)\AlkaSkin_Images</ImagesDestDir>

    </PropertyGroup>

    <MakeDir Directories="$(ImagesDestDir)" Condition="!Exists('$(ImagesDestDir)')" />

    <ItemGroup>

      <HatImageFiles Include="$(ImagesSourceDir)\*.png" />

    </ItemGroup>

    <Copy SourceFiles="@(HatImageFiles)" DestinationFolder="$(ImagesDestDir)" SkipUnchangedFiles="true" Condition="Exists('$(ImagesSourceDir)')" />

    <Message Importance="high" Text="[Deploy] PNG hat images -&gt; $(ImagesDestDir)" />

  </Target>

